    "version": "0.2.0",
    "configurations": [
       {
            "name": "Run Godot Run",
            "request": "launch",
            "type": "coreclr",
            "preLaunchTask": "build",
            "program": "D:/Program Files/Godot/Godot_v4.5.exe",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "args": ["--path", "${workspaceRoot}"]
        },

